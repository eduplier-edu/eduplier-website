<script>
/* ====== SETTINGS ====== */
var FORM_ENDPOINT = "";            // e.g. your Formspree URL: https://formspree.io/f/xxxxxxx
var THANK_YOU_URL = "thank-you.html"; // page that opens after a successful submit
/* ====================== */

document.querySelectorAll('[data-course]').forEach(function(a){
  a.addEventListener('click',function(){ document.getElementById('course').value=a.getAttribute('data-course'); });
});

var form=document.getElementById('leadForm'), msg=document.getElementById('msg'), btn=document.getElementById('btn');
function say(t,err){ msg.textContent=t; msg.className='msg'+(err?' err':''); }

form.addEventListener('submit',function(e){
  e.preventDefault();
  var d={name:name.value.trim(),phone:phone.value.trim(),email:email.value.trim(),course:course.value,state:state.value};
  if(d.name.length<2) return say('Please enter your full name.',1);
  if(!/^[6-9]\d{9}$/.test(d.phone)) return say('Enter a valid 10-digit mobile number.',1);
  if(!/^\S+@\S+\.\S+$/.test(d.email)) return say('Enter a valid email address.',1);
  if(!d.course) return say('Please select a course.',1);
  if(!d.state) return say('Please select your state.',1);
  if(!consent.checked) return say('Please tick the consent box to continue.',1);

  btn.disabled=true; say('Submitting...');
  var params=new URLSearchParams(location.search);
  ['utm_source','utm_medium','utm_campaign','utm_content','fbclid'].forEach(function(k){ d[k]=params.get(k)||''; });

  function done(){
    try{ fbq('track','Lead'); }catch(x){}
    setTimeout(function(){ location.href=THANK_YOU_URL; },400);
  }
  if(!FORM_ENDPOINT){ done(); return; }
  fetch(FORM_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(d)})
    .then(function(r){ if(r.ok) done(); else throw 0; })
    .catch(function(){ btn.disabled=false; say('Something went wrong. Please try again or call us.',1); });
});
</script>
