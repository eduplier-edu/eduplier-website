<style>
:root{
  --navy:#0f2a43; --navy2:#16385a; --ink:#17212b; --muted:#5b6876;
  --orange:#e8590c; --orange-d:#c94a05; --bg:#f4f7fa; --card:#fff; --line:#dbe3ea; --ok:#1d7a4d;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.55;padding-bottom:64px}
a{color:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:0 18px}
:focus-visible{outline:3px solid var(--orange);outline-offset:2px}

/* header */
header{background:var(--navy);color:#fff}
header .wrap{display:flex;justify-content:space-between;align-items:center;min-height:56px;gap:12px}
header strong{font-size:15px;font-weight:700}
.call{background:var(--orange);color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:9px 16px;border-radius:999px}

/* hero */
.hero{background:linear-gradient(180deg,var(--navy) 0%,var(--navy2) 100%);color:#fff;padding:28px 0 36px}
.hero .wrap{display:grid;gap:26px}
.hero h1{font-size:clamp(28px,6.2vw,46px);line-height:1.12;font-weight:800;letter-spacing:-.02em}
.hero p.sub{margin-top:12px;font-size:17px;color:#d3deea;max-width:46ch}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.chips span{font-size:13px;font-weight:500;border:1px solid rgba(255,255,255,.3);padding:6px 12px;border-radius:999px}
.hero ul{list-style:none;margin-top:20px;display:grid;gap:8px;font-size:15px}
.hero li:before{content:"✓";color:#ffb27a;font-weight:800;margin-right:9px}

/* form */
.form-card{background:#fff;color:var(--ink);border-radius:14px;padding:22px;box-shadow:0 10px 30px rgba(0,0,0,.25)}
.form-card h2{font-size:20px;line-height:1.25}
.form-card p.note{font-size:13px;color:var(--muted);margin:4px 0 14px}
label{display:block;font-size:13px;font-weight:700;margin:12px 0 5px}
input,select{width:100%;font:inherit;font-size:16px;padding:12px;border:1.5px solid var(--line);border-radius:8px;background:#fff;color:var(--ink)}
input:focus,select:focus{border-color:var(--navy);outline:none}
.consent{display:flex;gap:9px;align-items:flex-start;font-size:12px;color:var(--muted);margin-top:14px}
.consent input{width:18px;height:18px;margin-top:2px;flex:none}
button.submit{width:100%;margin-top:16px;background:var(--orange);color:#fff;font:inherit;font-weight:800;font-size:17px;border:0;border-radius:8px;padding:14px;cursor:pointer}
button.submit:hover{background:var(--orange-d)}
button.submit:disabled{opacity:.7;cursor:wait}
.msg{font-size:14px;margin-top:10px;min-height:20px}
.msg.err{color:#b3261e}

/* sections */
section{padding:44px 0}
h2.title{font-size:clamp(23px,4.6vw,32px);line-height:1.2;letter-spacing:-.015em;margin-bottom:8px}
p.lead{color:var(--muted);margin-bottom:24px;max-width:60ch}
.grid{display:grid;gap:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px}
.card h3{font-size:17px;margin-bottom:6px}
.card p{font-size:14.5px;color:var(--muted)}

/* programmes */
.prog{display:flex;flex-direction:column;gap:6px}
.prog .lvl{font-size:12px;font-weight:700;color:var(--navy2);background:#e4edf6;padding:3px 10px;border-radius:999px;align-self:flex-start}
.prog h3{font-size:19px;margin-top:4px}
.prog dl{display:grid;grid-template-columns:auto 1fr;gap:3px 12px;font-size:14px;margin:6px 0 10px}
.prog dt{color:var(--muted)}
.prog dd{font-weight:700}
.prog a.btn{margin-top:auto;text-align:center;text-decoration:none;font-weight:700;font-size:15px;border:2px solid var(--navy);color:var(--navy);padding:10px;border-radius:8px}
.prog a.btn:hover{background:var(--navy);color:#fff}
.fine{font-size:12.5px;color:var(--muted);margin-top:14px}

/* steps */
.steps{counter-reset:s;display:grid;gap:14px}
.step{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px 18px 18px 64px;position:relative}
.step:before{counter-increment:s;content:counter(s);position:absolute;left:18px;top:16px;width:32px;height:32px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;display:grid;place-items:center}
.step h3{font-size:16px}
.step p{font-size:14.5px;color:var(--muted)}

/* cta band */
.band{background:var(--navy);color:#fff;text-align:center;padding:40px 0}
.band h2{font-size:clamp(22px,4.5vw,30px);margin-bottom:8px}
.band p{color:#d3deea;margin-bottom:18px}
.band a{display:inline-block;margin:4px;text-decoration:none;font-weight:800;padding:13px 24px;border-radius:999px}
.band .a1{background:var(--orange);color:#fff}
.band .a2{border:2px solid #fff;color:#fff}

/* disclaimer */
.disclaimer{background:#e9eef3;padding:24px 0;font-size:12.5px;color:#46525e}
.disclaimer p+p{margin-top:8px}

/* sticky bar (mobile) */
.sticky{position:fixed;left:0;right:0;bottom:0;display:flex;gap:8px;padding:8px 10px;background:#fff;border-top:1px solid var(--line);z-index:20}
.sticky a{flex:1;text-align:center;text-decoration:none;font-weight:800;font-size:15px;padding:12px;border-radius:8px}
.sticky .s1{background:var(--navy);color:#fff}
.sticky .s2{background:var(--orange);color:#fff}

@media(min-width:720px){
  .grid.g2{grid-template-columns:repeat(2,1fr)}
  .grid.g4{grid-template-columns:repeat(4,1fr)}
  .steps{grid-template-columns:repeat(3,1fr)}
  .step{padding:64px 18px 18px}
  .step:before{top:18px}
