  .hero h1 .strike::after {
    content: ""; position: absolute; left: -2%; right: -2%; top: 54%; height: .09em;
    background: var(--marigold); transform-origin: left; transform: scaleX(0);
    animation: strike .9s .5s cubic-bezier(.7,0,.2,1) forwards;
  }
  @keyframes strike { to { transform: scaleX(1); } }
  .hero p.lead { margin-top: 1.5rem; font-size: 1.2rem; max-width: 34em; }
  .hero-actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .9rem; }

  /* The funnel visual: 30+ options narrowed to 1 */
  .funnel { background: var(--ink); border-radius: 28px; padding: 1.75rem; color: var(--white); position: relative; box-shadow: 0 30px 60px -30px rgba(13,43,69,.55); }
  .funnel-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.25rem; }
  .funnel-head b { font-family: var(--font-display); font-size: 1.1rem; }
  .funnel-head span { font-size: .85rem; opacity: .7; }
  .dots { display: grid; grid-template-columns: repeat(10, 1fr); gap: 7px; }
  .dots i { aspect-ratio: 1; border-radius: 50%; background: rgba(255,255,255,.16); display: block; }
  .dots i.keep { background: rgba(255,255,255,.55); }
  .dots i.pick { background: var(--marigold); box-shadow: 0 0 0 5px rgba(255,180,0,.25); }
  .funnel-steps { margin-top: 1.4rem; display: grid; gap: .7rem; }
  .funnel-steps div { display: flex; justify-content: space-between; align-items: center; font-size: .95rem; padding: .7rem 1rem; border-radius: 12px; background: rgba(255,255,255,.07); }
  .funnel-steps div strong { color: var(--marigold); font-family: var(--font-display); font-size: 1.15rem; }
  .funnel-steps div:last-child { background: var(--marigold); color: var(--ink); font-weight: 600; }
  .funnel-steps div:last-child strong { color: var(--ink); }
  .badge-float {
    position: absolute; top: -18px; right: 22px; background: var(--mint); color: #0B5A3C;
    font-weight: 600; font-size: .85rem; padding: .45rem .9rem; border-radius: 999px;
    border: 2px solid var(--paper);
  }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }

  /* ---------- Story ---------- */
