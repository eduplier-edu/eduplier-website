  @media (max-width: 900px) { .story-grid { grid-template-columns: 1fr; } .photos { min-height: 400px; } }

  /* ---------- What we do ---------- */
  .do { background: var(--white); border-block: 1px solid var(--line); }
  .do-head { max-width: 40em; }
  .do-head h2 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.02em; }
  .do-head p { margin-top: 1rem; }
  .do-list { margin-top: 3rem; border-top: 2px solid var(--ink); }
  .do-row { display: grid; grid-template-columns: 70px 1fr 1.4fr; gap: 1.5rem; align-items: baseline; padding: 1.7rem 0; border-bottom: 1px solid var(--line); transition: background .2s ease, padding .2s ease; }
  .do-row:hover { background: var(--paper); padding-inline: 1rem; }
  .do-row .ico { font-size: 1.8rem; }
  .do-row h3 { font-size: 1.5rem; letter-spacing: -.01em; }
  @media (max-width: 760px) { .do-row { grid-template-columns: 48px 1fr; } .do-row p { grid-column: 2; } }

  /* ---------- Stats band ---------- */
  .stats { background: var(--ink); color: var(--white); padding: clamp(3rem, 6vw, 5rem) 0; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .stat b { display: block; font-family: var(--font-display); font-weight: 800; font-size: clamp(2.6rem, 5vw, 4rem); color: var(--marigold); line-height: 1; letter-spacing: -.02em; }
  .stat span { display: block; margin-top: .6rem; opacity: .85; }
  .stat { border-left: 2px solid rgba(255,255,255,.18); padding-left: 1.25rem; }
  @media (max-width: 760px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }

  /* ---------- Process (real sequence, so numbered) ---------- */
  .process-head { max-width: 38em; }
  .process-head h2 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.02em; }
  .process-head p { margin-top: 1rem; }
  .steps { margin-top: 3.2rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; position: relative; counter-reset: s; }
  .steps::before { content: ""; position: absolute; top: 27px; left: 5%; right: 5%; border-top: 3px dashed var(--line); z-index: 0; }
  .step { position: relative; z-index: 1; counter-increment: s; }
  .step::before {
    content: counter(s); display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%;
    background: var(--marigold); color: var(--ink); font-family: var(--font-display); font-weight: 800; font-size: 1.4rem;
    box-shadow: 0 0 0 8px var(--paper);
  }
  .step h3 { font-size: 1.25rem; margin: 1.1rem 0 .5rem; }
  .step p { font-size: .98rem; }
  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, 1fr); } .steps::before { display: none; } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }

  /* ---------- Promise ---------- */
  .promise { background: var(--mint); }
  .promise-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .promise h2 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.02em; color: #0B3B2B; }
  .promise > .wrap > .promise-grid > div:first-child p { margin-top: 1.2rem; color: #25594A; }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .checks li { background: var(--white); border-radius: 16px; padding: 1.2rem 1.4rem 1.2rem 4rem; position: relative; color: var(--ink-soft); }
  .checks li strong { display: block; color: var(--ink); font-family: var(--font-display); font-size: 1.1rem; margin-bottom: .2rem; }
  .checks li::before {
    content: "✓"; position: absolute; left: 1.2rem; top: 1.2rem; width: 32px; height: 32px; border-radius: 50%;
    background: #0B5A3C; color: var(--white); display: grid; place-items: center; font-weight: 700;
  }
  @media (max-width: 860px) { .promise-grid { grid-template-columns: 1fr; } }

  /* ---------- Programs ---------- */
  .programs { text-align: center; }
  .programs h2 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.02em; }
  .programs p.sub { margin: 1rem auto 0; max-width: 34em; }
  .chips { margin-top: 2.2rem; display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; }
  .chips a {
    text-decoration: none; font-weight: 600; color: var(--ink); background: var(--white);
    border: 2px solid var(--line); padding: .7rem 1.4rem; border-radius: 999px;
