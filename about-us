  .brand-logo { height: 40px; width: auto; display: block; }
  .nav { display: flex; gap: 1.75rem; align-items: center; }
  .nav a { text-decoration: none; font-weight: 500; font-size: .98rem; }
  .nav a:hover, .nav a[aria-current="page"] { color: var(--ink); }
  .nav a[aria-current="page"] { box-shadow: inset 0 -3px 0 var(--marigold); }
  @media (max-width: 860px) { .nav a:not(.btn) { display: none; } }

  /* ---------- Hero ---------- */
  .hero { padding-top: clamp(3.5rem, 7vw, 6rem); overflow: hidden; }
