  .chips a:hover { border-color: var(--marigold); background: var(--marigold); transform: translateY(-3px); }

  /* ---------- CTA ---------- */
  .cta { padding-top: 0; }
  .cta-box {
    background: var(--ink); border-radius: 32px; padding: clamp(2.5rem, 6vw, 4.5rem);
    display: grid; grid-template-columns: 1.3fr .7fr; gap: 2rem; align-items: center; position: relative; overflow: hidden;
  }
  .cta-box::after { content: ""; position: absolute; right: -80px; top: -80px; width: 280px; height: 280px; border-radius: 50%; background: var(--marigold); opacity: .15; }
  .cta-box h2 { color: var(--white); font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.02em; }
  .cta-box p { margin-top: 1rem; color: rgba(255,255,255,.8); max-width: 32em; }
  .cta-actions { display: grid; gap: .9rem; position: relative; z-index: 1; }
  .cta-actions .btn { justify-content: center; }
  .wa { background: #25D366; color: #063D1C; }
  .wa:hover { background: #1fb858; transform: translateY(-2px); }
  @media (max-width: 860px) { .cta-box { grid-template-columns: 1fr; } }

  /* ---------- Footer (replace with your site footer) ---------- */
  footer { border-top: 1px solid var(--line); padding: 2.5rem 0; font-size: .9rem; }
