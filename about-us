  .photos { position: relative; min-height: 440px; }
  .photos img { border-radius: var(--radius); object-fit: cover; box-shadow: 0 20px 40px -20px rgba(13,43,69,.4); }
  .photos .p1 { width: 78%; height: 380px; }
  .photos .p2 { position: absolute; right: 0; bottom: 0; width: 55%; height: 250px; border: 6px solid var(--paper); }
  .photos .stat-chip {
    position: absolute; left: 8%; bottom: 14px; background: var(--marigold); color: var(--ink);
    padding: .9rem 1.3rem; border-radius: 16px; font-family: var(--font-display); font-weight: 800;
