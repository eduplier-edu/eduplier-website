<script>
  // Builds the 30-dot "shortlist" visual in the hero
  (function () {
    var box = document.getElementById('dots');
    if (!box) return;
    var total = 30, keep = [4, 11, 17, 22, 26], pick = 17;
    for (var i = 0; i < total; i++) {
      var d = document.createElement('i');
      if (i === pick) d.className = 'pick';
      else if (keep.indexOf(i) > -1) d.className = 'keep';
      box.appendChild(d);
    }
  })();
</script>
