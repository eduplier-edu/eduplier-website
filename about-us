  :focus-visible { outline: 3px solid var(--sky); outline-offset: 3px; border-radius: 6px; }

  .wrap { width: min(1160px, 100% - 2.5rem); margin-inline: auto; }
  section { padding: clamp(4rem, 8vw, 7rem) 0; }

  /* ---------- Buttons ---------- */
  .btn {
